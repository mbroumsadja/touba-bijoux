+              {tab === 'produits' && <Products stats={stats} say={say} openId={openId} onOpened={() => setOpenId(null)} />}
+              {tab === 'marketing' && <Marketing stats={stats} period={period} onPeriod={setPeriod} statusId={statusId} onClearAll={clearAll} />}
+              {tab === 'boutique' && <Shop say={say} />}
