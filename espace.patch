+
+type Tab = 'apercu' | 'produits' | 'marketing' | 'boutique';
+const TABS = [
+  { id: 'apercu', label: 'Aperçu', Icon: LayoutGrid },
+  { id: 'produits', label: 'Produits', Icon: Gem },
+  { id: 'marketing', label: 'Marketing', Icon: Megaphone },
