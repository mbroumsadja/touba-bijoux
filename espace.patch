+  say: (msg: string, ok?: boolean) => void;
+  openId: string | null;
+  onOpened: () => void;
+}
+
+export const Products: React.FC<Props> = ({ stats, say, openId, onOpened }) => {
+  const s = useStore();
+  const { products } = s;
