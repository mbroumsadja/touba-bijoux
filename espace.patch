+import React, { useEffect, useMemo, useState } from 'react';
+import { Check, Copy, Download, MessageCircle, Trash2 } from 'lucide-react';
+import { useStore } from '../lib/store';
+import { CATEGORIES } from '../lib/initialData';
+import { WEEKDAYS, Stats, exportCsv } from '../lib/analytics';
+import { formatFCFA } from '../lib/whatsapp';
+import { Product } from '../types';
+import { PeriodChips } from './Overview';
+import { Bar, Section, btnGhost, btnPrimary, fmt, inputCls, labelCls, plural } from './ui';
+
+const caption = (p: Product, shop: string, url: string) =>
+  [
+    `${p.isNew ? '✨ Nouveau ! ' : '✨ '}${p.name}`,
+    p.price > 0 ? `Prix : ${formatFCFA(p.price)}` : 'Prix sur demande',
+    (p.wholesalePrice ?? 0) > 0 ? `Prix de gros : ${formatFCFA(p.wholesalePrice!)}` : '',
+    '',
+    `📲 Commandez sur WhatsApp ou voyez tout le catalogue : ${url}`,
+    'Livraison dans tout le Cameroun. Paiement à la livraison, Orange Money ou MTN MoMo.',
+    `${shop}`,
+  ]
+    .filter((l, i, a) => l !== '' || (i > 0 && a[i - 1] !== ''))
+    .join('\n');
+
+interface Props {
+  stats: Stats;
+  period: number;
+  onPeriod: (d: number) => void;
+  statusId: string | null;
+  onClearAll: () => void;
+}
+
+export const Marketing: React.FC<Props> = ({ stats, period, onPeriod, statusId, onClearAll }) => {
+  const { products, settings } = useStore();
+  const sellable = products.filter((p) => !p.hidden && !p.soldOut);
+  const suggested = stats.ranked.find((r) => !r.product.hidden && !r.product.soldOut)?.product.id ?? sellable[0]?.id ?? '';
+  const [pid, setPid] = useState(statusId ?? suggested);
+  const [text, setText] = useState('');
+  const [copied, setCopied] = useState(false);
+  const product = products.find((p) => p.id === pid);
+
+  useEffect(() => {
+    if (statusId) setPid(statusId);
+  }, [statusId]);
+  useEffect(() => {
+    if (!pid && suggested) setPid(suggested);
+  }, [pid, suggested]);
+  useEffect(() => {
+    if (product) setText(caption(product, settings.shopName, window.location.origin));
+  }, [product, settings.shopName]);
+
+  const copy = async () => {
+    try {
+      await navigator.clipboard.writeText(text);
+      setCopied(true);
+      setTimeout(() => setCopied(false), 2500);
+    } catch {
+      /* l'utilisatrice peut copier à la main */
+    }
+  };
+
+  const hourRange = useMemo(() => Array.from({ length: 17 }, (_, i) => i + 6), []);
+  const maxHour = Math.max(1, ...hourRange.map((h) => stats.hours[h]));
+  const bestHour = stats.hours.indexOf(Math.max(...stats.hours));
+  const maxWd = Math.max(1, ...stats.weekdays);
+  const maxCat = Math.max(1, ...stats.byCategory.map((c) => c.interest));
+  const maxPrice = Math.max(1, ...stats.byPrice.map((p) => p.views + p.demands * 3));
+  const totalD = stats.orders + stats.wholesale;
+  const tips = stats.insights.filter((i) => !i.action);
+
+  const download = () => {
+    const blob = new Blob([exportCsv(stats, (id) => CATEGORIES.find((c) => c.id === id)?.fr ?? id)], { type: 'text/csv;charset=utf-8' });
+    const a = document.createElement('a');
+    a.href = URL.createObjectURL(blob);
+    a.download = `touba-produits-${new Date().toISOString().slice(0, 10)}.csv`;
+    a.click();
+    URL.revokeObjectURL(a.href);
+  };
+
+  return (
+    <div>
+      <h1 className="font-display text-[1.75rem] sm:text-4xl font-semibold leading-[1.15] text-encre max-w-xl">Faites connaître vos meilleures pièces.</h1>
+      <div className="mt-4"><PeriodChips period={period} onChange={onPeriod} /></div>
+
+      <Section title="Votre statut WhatsApp" hint="Le produit le plus demandé est choisi pour vous. Copiez le texte, puis ajoutez la photo.">
+        {sellable.length === 0 ? (
+          <p className="text-sm text-encre/70">Aucun produit en vente. Ajoutez un produit ou remettez-en un en vente.</p>
+        ) : (
+          <div className="grid sm:grid-cols-[10rem_1fr] gap-5 items-start">
+            {product && (
+              <div>
+                <img src={product.images[0]} alt="" className="w-40 h-40 rounded-md object-cover bg-papier" />
+                <a href={product.images[0]} download={`${product.reference}.webp`} className="mt-2 inline-flex items-center gap-1.5 h-11 text-sm font-medium underline underline-offset-4 decoration-or">
+                  <Download className="w-4 h-4" /> Enregistrer la photo
+                </a>
+              </div>
+            )}
+            <div className="space-y-3">
+              <div>
+                <label className={labelCls} htmlFor="m-product">Produit à annoncer</label>
+                <select id="m-product" value={pid} onChange={(e) => setPid(e.target.value)} className={inputCls}>
+                  {sellable.map((p) => (
+                    <option key={p.id} value={p.id}>{p.name} (Réf. {p.reference})</option>
+                  ))}
+                </select>
+              </div>
+              <div>
+                <label className={labelCls} htmlFor="m-text">Texte du statut</label>
+                <textarea id="m-text" rows={8} value={text} onChange={(e) => setText(e.target.value)} className={`${inputCls} h-auto py-3 leading-relaxed`} />
+              </div>
+              <div className="flex flex-wrap gap-3">
+                <button type="button" onClick={copy} className={btnPrimary}>
+                  {copied ? <Check className="w-5 h-5" /> : <Copy className="w-5 h-5" />} {copied ? 'Texte copié' : 'Copier le texte'}
